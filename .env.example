# ==========================================
# MonitorX & E-Commerce Monorepo Environment Variables
# ==========================================

# --- E-Commerce Backend (Django) ---
DEBUG=True
SECRET_KEY=django-insecure-example-secret-key-change-in-production
JWT_SECRET=jwt-insecure-example-secret-key-change-in-production
DATABASE_URL=postgres://ecommerce_user:ecommerce_pass@postgres:5432/ecommerce_db
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# --- E-Commerce PostgreSQL (Docker Container) ---
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=ecommerce_pass

# --- Monitoring Agent (Python / FastAPI / psutil) ---
MONITORING_API_KEY=mon_api_key_example_secret_12345
MONITORX_URL=http://monitorx-backend:8000
ECOMMERCE_BACKEND_HEALTH_URL=http://backend:8000/api/health
AGENT_POLL_INTERVAL=10

# --- MonitorX Backend (FastAPI / SQLAlchemy) ---
MONITORX_DATABASE_URL=postgresql://monitorx_user:monitorx_pass@monitorx-db:5432/monitorx_db
MONITORX_SECRET_KEY=monitorx-insecure-example-secret-key-change-in-production
MONITORX_POSTGRES_DB=monitorx_db
MONITORX_POSTGRES_USER=monitorx_user
MONITORX_POSTGRES_PASSWORD=monitorx_pass
